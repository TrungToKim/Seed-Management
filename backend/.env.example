DB_URL=postgresql://user:password@host:port/dbname
PROD_DB_URL=postgresql://prod_user:prod_password@prod_host:port/prod_dbname
GOOGLE_API_KEY=your_google_api_key
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
AUTH_SECRET=your_secret_key_for_signing_tokens

# Light AI deployment (512MB server): models are served by Google Cloud,
# so no local PyTorch / sentence-transformers is required.
GOOGLE_LLM_MODEL=gemini-3.1-flash-lite
GOOGLE_EMBED_MODEL=gemini-embedding-2
EMBEDDING_COLLECTION=caythuoc_docs

# First admin account, created by `python setup_db.py`
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me
ADMIN_EMAIL=admin@example.com